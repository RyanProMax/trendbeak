{
  "name": "trendbeak",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build && wrangler pages dev dist",
    "build": "node scripts/build-shell.mjs && npm run check && vite build && vite build --mode client",
    "preview": "npm run build && wrangler pages dev dist",
    "pages:dev": "npm run preview",
    "test:budget": "node scripts/server-budget-check.mjs",
    "security:check": "node scripts/check-public-repo.mjs",
    "market:prepare": "node scripts/market-sync.mjs prepare",
    "market:schema": "node scripts/market-sync.mjs schema",
    "market:init": "node scripts/market-sync.mjs init",
    "market:sync": "node scripts/market-sync.mjs sync",
    "market:rebuild": "node scripts/market-sync.mjs rebuild",
    "sentiment:seed": "node scripts/sentiment-sync.mjs seed",
    "sentiment:sync": "node scripts/sentiment-sync.mjs sync",
    "deploy": "npm run build && wrangler pages deploy dist --project-name trendbeak --branch main --commit-dirty=true",
    "test:visual": "REVIEW_SCHEME=light node scripts/market-ui-check.mjs && REVIEW_SCHEME=dark node scripts/market-ui-check.mjs",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=4 tests/*.test.mjs",
    "daily:sync": "node scripts/daily-sync.mjs"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.19",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "d3-shape": "3.2.0",
    "hono": "^4.12.32",
    "lucide-react": "^1.26.0",
    "react": "^19.2.6",
    "react-activity-calendar": "3.2.1",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260723.1",
    "@hono/vite-build": "^1.11.1",
    "@playwright/test": "1.64.1",
    "@types/d3-shape": "3.1.8",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "typescript": "5.9.3",
    "vite": "^8.1.5",
    "wrangler": "4.114.0"
  }
}
