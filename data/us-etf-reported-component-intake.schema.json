{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trendbeak:reported-common-component-intake:r2",
  "description": "Supplementary risk and independent metric disposition contract. Not a source approval or full issuer schema. Runtime additionally checks pinned review inventory, source references, identities, dates and arithmetic.",
  "type": "object",
  "required": [
    "riskAssessment",
    "commonBook",
    "revenue"
  ],
  "properties": {
    "riskAssessment": {
      "type": "object",
      "required": [
        "knownCapitalLag",
        "knownBookScopeLag",
        "reportedPerimeterLag"
      ],
      "properties": {
        "knownCapitalLag": {
          "type": "object",
          "required": [
            "status",
            "evidenceRefs",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "known",
                "none",
                "unknown"
              ]
            },
            "evidenceRefs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "known",
                      "none"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "evidenceRefs": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        },
        "knownBookScopeLag": {
          "type": "object",
          "required": [
            "status",
            "evidenceRefs",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "known",
                "none",
                "unknown"
              ]
            },
            "evidenceRefs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "known",
                      "none"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "evidenceRefs": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        },
        "reportedPerimeterLag": {
          "type": "object",
          "required": [
            "status",
            "evidenceRefs",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "known",
                "none",
                "unknown"
              ]
            },
            "evidenceRefs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "known",
                      "none"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "evidenceRefs": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        }
      }
    },
    "commonBook": {
      "type": "object",
      "required": [
        "independentAuditVerified",
        "verifiedInput",
        "independentAuditRefs"
      ],
      "properties": {
        "independentAuditVerified": {
          "type": "boolean"
        },
        "verifiedInput": {
          "type": "boolean"
        },
        "independentAuditRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "independentAuditVerified": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "verifiedInput": {
                "const": true
              },
              "independentAuditRefs": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "verifiedInput": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "revenue": {
      "type": "object",
      "required": [
        "independentAuditVerified",
        "verifiedInput",
        "independentAuditRefs"
      ],
      "properties": {
        "independentAuditVerified": {
          "type": "boolean"
        },
        "verifiedInput": {
          "type": "boolean"
        },
        "independentAuditRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "independentAuditVerified": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "verifiedInput": {
                "const": true
              },
              "independentAuditRefs": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "verifiedInput": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}
